FROM python:3.12-slim AS uv-build

WORKDIR /app
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY app/ /app/

# Install uv, use it to install deps, then remove uv to save space
RUN pip install --no-cache-dir uv && \
    uv pip install -r requirements.txt && \
    pip uninstall -y uv && \
    rm -rf /root/.cache /opt/venv/lib/python3.12/site-packages/uv* /opt/venv/bin/uv

CMD ["python", "main.py"]
